APP_NAME="WKWKWKWK"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

# "id" makes <html lang> and translated dates (e.g. email due dates) Indonesian.
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local default: SQLite at database/database.sqlite (created by `php artisan migrate`).
# Keep the database file out of the project root; database/*.sqlite is git-ignored.
DB_CONNECTION=sqlite
# MySQL instead:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=myshop
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local: emails are written to storage/logs/laravel.log. Production: smtp (see below).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Store profile (config/shop.php). The address's second-to-last part is shown as "Dikirim dari ...".
SHOP_EMAIL=halo@myshop.test
SHOP_PHONE=0812-0000-0000
SHOP_ADDRESS="Jl. Contoh No. 1, Bandung, Jawa Barat"
# SHOP_DESCRIPTION="Ponsel, laptop, audio dan aksesori dengan harga yang jelas."
# The simulator lets customers mark their own orders paid: on outside production, off in production.
# Set true only for a public demo; the storefront then labels itself as a demo.
# SHOP_PAYMENT_SIMULATOR=false
# Shown to customers as the transfer destination when the simulator is off.
SHOP_BANK_ACCOUNT="BCA 0000000000 a.n. MyShop"
# Product and category photos: "public" (server disk) or "s3" (object storage, needs league/flysystem-aws-s3-v3).
# SHOP_MEDIA_DISK=public
# Content-Security-Policy header: on by default in production. Keep it off while running the Vite dev server.
# SHOP_CSP=true
# Search engine indexing (robots.txt, meta robots): on by default in production only.
# SHOP_INDEXABLE=true

# ---------------------------------------------------------------------------
# Production checklist: set these before going live.
# ---------------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain            (HTTPS only: production forces https URLs and secure cookies)
# APP_KEY=                               (php artisan key:generate --show; never reuse the local key)
# LOG_CHANNEL=stderr                     (containers / PaaS) or LOG_STACK=daily on a VPS
# LOG_LEVEL=warning
# DB_CONNECTION=mysql (or pgsql) plus DB_HOST / DB_PORT / DB_DATABASE / DB_USERNAME / DB_PASSWORD
# MAIL_MAILER=smtp plus MAIL_HOST / MAIL_PORT / MAIL_USERNAME / MAIL_PASSWORD / MAIL_FROM_ADDRESS
# TRUSTED_PROXIES=                       (load balancer IPs/CIDRs; Laravel Cloud and Forge need nothing)
# SHOP_MEDIA_DISK=s3 plus AWS_* when the host wipes local files on deploy
# SESSION_SECURE_COOKIE defaults to true in production.
#
# Processes: web server, a queue worker (`php artisan queue:work --tries=3`) and the scheduler
# (`php artisan schedule:run` every minute). Health check: GET /up.
# Build: composer install --no-dev -o && npm ci && npm run build
# Release: composer deploy (migrate --force, storage:link, optimize, queue:restart)
# First admin: register on the site, then `php artisan shop:make-admin you@example.com`.
