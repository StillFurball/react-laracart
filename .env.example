APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=myshop
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# smtp to send email
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Store profile and payment (config/shop.php)
SHOP_EMAIL=halo@myshop.test
SHOP_PHONE=0812-0000-0000
SHOP_ADDRESS="Jl. Ndoli"
# Off by default when APP_ENV=production; set true only for a public demo.
# SHOP_PAYMENT_SIMULATOR=false
# Shown to customers as the transfer destination when the simulator is off.
SHOP_BANK_ACCOUNT="BCA 0000000000 a.n. MyShop"

# Production: change these before going live.
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain
# LOG_STACK=daily
# LOG_LEVEL=warning
# SESSION_SECURE_COOKIE=true
# DB_CONNECTION=mysql (plus DB_HOST / DB_DATABASE / DB_USERNAME / DB_PASSWORD)
# MAIL_MAILER=smtp (plus MAIL_HOST / MAIL_PORT / MAIL_USERNAME / MAIL_PASSWORD / MAIL_FROM_ADDRESS)
# Run alongside the web server: `php artisan queue:work` and a cron for `php artisan schedule:run`.
# Deploy: composer install --no-dev -o && npm ci && npm run build && composer deploy
# First admin: register on the site, then `php artisan shop:make-admin you@example.com`.
